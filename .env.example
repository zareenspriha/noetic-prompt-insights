# Optional live adapters; mock mode is the default. Never commit actual keys.
PROVIDER_MODE=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=
ANTHROPIC_MODEL=
# USD per million tokens, copied from your provider's pricing page. Unset = cost reported as null.
OPENAI_PRICE_IN_PER_MTOK=
OPENAI_PRICE_OUT_PER_MTOK=
ANTHROPIC_PRICE_IN_PER_MTOK=
ANTHROPIC_PRICE_OUT_PER_MTOK=
# Bearer token for GET /events; never written into importer summaries.
GATEWAY_TOKEN=
# Reviewer tokens for POST /feedback (name:token, comma-separated, tokens 16+ characters).
# Without any, corrections are refused unless PI_ENV=development.
PI_REVIEWER_TOKENS=
# development = allow tokenless corrections (as "local-dev") and serve /docs. Leave unset for demos.
PI_ENV=
# Append-only record of every correction and undo (labels only, no prompt text).
PI_AUDIT_LOG=artifacts/audit.ndjson
